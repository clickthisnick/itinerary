{
  "name": "itinerary",
  "version": "1.0.0",
  "private": true,
  "description": "Itinerary to better prepare for events.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "prepare": "node scripts/install-hooks.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run html && npm run css && npm run spell && npm run actions && npm run test:ci && npm run size && npm run links",
    "check:fast": "npm run format:check && npm run lint && npm run typecheck && npm run html && npm run css && npm run spell && npm run test:ci && npm run size",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "html": "html-validate --config htmlvalidate.config.js index.html itinerary.html",
    "css": "stylelint \"assets/**/*.css\"",
    "spell": "node scripts/codespell.js",
    "actions": "node scripts/actionlint.js",
    "links": "linkinator index.html itinerary.html --recurse=false --silent",
    "test": "node --test tests/*.test.mjs",
    "test:ci": "node --test --experimental-test-coverage --test-coverage-include=itinerary.js --test-coverage-lines=100 --test-coverage-branches=97 --test-coverage-functions=100 tests/*.test.mjs",
    "size": "node scripts/size-budget.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "html-validate": "^11.21.1",
    "lefthook": "^2.2.2",
    "linkinator": "^8.1.0",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "^7.0.2"
  }
}
